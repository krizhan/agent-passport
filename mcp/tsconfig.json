{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["index.ts", "src/**/*.ts", "scripts/demo.ts"],
  "exclude": ["node_modules", "dist", ".demo-build"]
}
