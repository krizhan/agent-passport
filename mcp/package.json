{
  "name": "agent-passport",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "0.10.0",
  "description": "Hardcoded trade scenarios, advisory purchase and marketing checks, and bundled U.S. restricted-party screening",
  "license": "MIT",
  "scripts": {
    "prebuild": "node scripts/prepare-screening-list.mjs",
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "refresh:screening-list": "node scripts/refresh-screening-list.mjs",
    "demo:trade": "tsc -p tsconfig.trade.json && node scripts/prepare-trade-build.mjs && node scripts/export-trade-demo.mjs"
  },
  "dependencies": {
    "iso-3166": "4.4.0",
    "mcp-use": "2.10.1",
    "zod": "^4.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "@mcp-use/client": "^2.4.4"
  }
}
